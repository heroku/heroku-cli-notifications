{
  "name": "@heroku-cli/notifications",
  "description": "display notifications in Heroku CLI commands",
  "version": "1.2.9",
  "author": "Heroku",
  "bugs": "https://github.com/heroku/heroku-cli-notifications/issues",
  "devDependencies": {
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9",
    "eslint-config-oclif": "^6.0.144",
    "rimraf": "^6.1.3",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "/assets",
    "/lib"
  ],
  "homepage": "https://github.com/heroku/heroku-cli-notifications",
  "keywords": [
    "oclif"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "repository": "heroku/heroku-cli-notifications",
  "scripts": {
    "clean": "rimraf lib",
    "build": "npm run clean && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=lcovonly",
    "prepare": "npm run build"
  },
  "types": "lib/index.d.ts"
}
